# Rc0 hub: the internet-facing part of the training server (tasks, uploads, validation, network downloads).
# Built without any neural-network backend: it only needs `rc0 validate`, which replays games with the rules.
# Training stays outside the container (see deploy/README.md).
# SPDX-License-Identifier: GPL-3.0-or-later
FROM docker.io/library/debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake g++ make && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY CMakeLists.txt ./
COPY rules rules
COPY src src
COPY tests tests
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DRC0_NATIVE=OFF -DRC0_TORCH=OFF -DRC0_TRT=OFF -DRC0_ONNX=OFF \
 && cmake --build build -j 4 --target rc0 test_rules \
 && ./build/test_rules 3

FROM docker.io/library/python:3.12-slim-bookworm
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin rc0
COPY --from=build /src/build/rc0 /app/build/rc0
COPY server/rc0_server.py /app/server/rc0_server.py
USER 10001
WORKDIR /app
EXPOSE 8000
ENTRYPOINT ["python3", "/app/server/rc0_server.py", "serve", "--data", "/data", "--inbox", "/inbox", "--port", "8000"]
